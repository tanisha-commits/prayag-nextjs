        <button class="control-btn" id="next-video" aria-label="Next video">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
        </button>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const videoSlides  = document.querySelectorAll('.video-slide');
    const progressDots = document.querySelectorAll('.progress-dot');
    const soundToggle  = document.getElementById('sound-toggle');
    const nextVideoBtn = document.getElementById('next-video');
    const soundOffIcon = document.getElementById('sound-off-icon');
    const soundOnIcon  = document.getElementById('sound-on-icon');

    let currentVideoIndex = 0;
    let isMuted           = true;
    let isLooping         = true;
    let lcpFired          = false;

    /* --------------------------------------------------
       Track LCP — don't swap video in until it fires
    -------------------------------------------------- */
    if ('PerformanceObserver' in window) {
        try {
            const lcpObserver = new PerformanceObserver(() => {
                lcpFired = true;
                lcpObserver.disconnect();
            });
            lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
        } catch (e) {
            lcpFired = true;
        }
    } else {
        lcpFired = true;
    }

    /* --------------------------------------------------
       Swap thumbnail <picture> → <video> after LCP fired
    -------------------------------------------------- */
    function trySwapToVideo(video) {
        if (!video || video.dataset.swapped === 'true') return;

        const doSwap = () => {
            video.dataset.swapped = 'true';
            video.classList.add('video-ready');

            // Hide sibling <picture> for older browsers
            const picture = video.parentElement.querySelector('picture');
            if (picture) picture.classList.add('img-hidden');

            video.play().catch(e => console.log('Autoplay prevented:', e));
        };

        const onCanPlay = () => {
            video.removeEventListener('canplay', onCanPlay);
            if (lcpFired) {
                doSwap();
            } else {
                let waited = 0;
                const poll = setInterval(() => {
                    waited += 50;
                    if (lcpFired || waited >= 3000) {
                        clearInterval(poll);
                        doSwap();
                    }
                }, 50);
            }
        };

        if (video.readyState >= 3) {
            onCanPlay();
        } else {
            video.addEventListener('canplay', onCanPlay);
        }
    }

    /* --------------------------------------------------
       Start loading a video (deferred)
    -------------------------------------------------- */
    function startLoadingVideo(slide) {
        const video = slide.querySelector('video');
        if (!video || video.dataset.loadStarted === 'true') return;
        video.dataset.loadStarted = 'true';
        video.preload = 'auto';
        video.load();
        trySwapToVideo(video);
    }

    /* --------------------------------------------------
       Event listeners on all video elements
    -------------------------------------------------- */
    function setupVideoEventListeners() {
        videoSlides.forEach((slide, index) => {
            const video = slide.querySelector('video');
            if (!video) return;
            video.addEventListener('ended', () => {
                if (isLooping) nextVideo();
            });
            video.addEventListener('error', (e) => {
                console.warn('Video error on slide', index, e);
            });
        });
    }

    /* --------------------------------------------------
       Switch to slide by index
    -------------------------------------------------- */
    function switchVideo(index) {
        if (index < 0 || index >= videoSlides.length) return;

        const currentVideo = videoSlides[currentVideoIndex].querySelector('video');
        if (currentVideo) currentVideo.pause();

        videoSlides[currentVideoIndex].classList.remove('active');
        progressDots[currentVideoIndex].classList.remove('active');

        currentVideoIndex = index;

        videoSlides[currentVideoIndex].classList.add('active');
        progressDots[currentVideoIndex].classList.add('active');

        const newSlide = videoSlides[currentVideoIndex];
        const newVideo = newSlide.querySelector('video');

        if (newVideo) {
            newVideo.muted = isMuted;
            if (newVideo.dataset.loadStarted !== 'true') {
                startLoadingVideo(newSlide);
            } else if (newVideo.dataset.swapped === 'true') {
                newVideo.currentTime = 0;
                newVideo.play().catch(e => console.log('Autoplay prevented:', e));
            } else {
                trySwapToVideo(newVideo);
            }
        }
    }

    function nextVideo() {
        switchVideo((currentVideoIndex + 1) % videoSlides.length);
    }

    /* --------------------------------------------------
       Sound toggle
    -------------------------------------------------- */
    soundToggle.addEventListener('click', function () {
        isMuted = !isMuted;
        videoSlides.forEach(slide => {
            const video = slide.querySelector('video');
            if (video) video.muted = isMuted;
        });
        soundOffIcon.style.display = isMuted  ? 'block' : 'none';
        soundOnIcon.style.display  = !isMuted ? 'block' : 'none';
    });

    /* --------------------------------------------------
       Navigation
    -------------------------------------------------- */
    nextVideoBtn.addEventListener('click', nextVideo);

    progressDots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
            if (index !== currentVideoIndex) switchVideo(index);
        });
    });

    /* --------------------------------------------------
       Pause / resume on tab visibility change
    -------------------------------------------------- */
    document.addEventListener('visibilitychange', () => {
        const currentVideo = videoSlides[currentVideoIndex].querySelector('video');
        if (currentVideo && currentVideo.dataset.swapped === 'true') {
            document.hidden
                ? currentVideo.pause()
                : currentVideo.play().catch(() => {});
        }
    });

    /* --------------------------------------------------
       Init
    -------------------------------------------------- */
    setupVideoEventListeners();

    // Defer first video load until browser is idle
    // so LCP <img> inside <picture> paints first
    if ('requestIdleCallback' in window) {
        requestIdleCallback(
            () => startLoadingVideo(videoSlides[0]),
            { timeout: 2500 }
        );
    } else {
        setTimeout(() => startLoadingVideo(videoSlides[0]), 800);
    }

    console.log('Video showcase ready —', videoSlides.length, 'slides');
});
</script>
