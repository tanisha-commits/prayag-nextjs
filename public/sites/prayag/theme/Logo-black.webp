<style>
.official-ipl {
    background: #fff;
    PADDING: 0px 0px 100px 0px;
}
        
.ipl-head h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 0;
}
        


.prayag-btn {
    position: relative;
    background-color: #000;
    color: #fff;
    display: inline-block;
    border-radius: 28px;
    padding: 13px 40px 13px 35px;
    font-weight: 500;
    font-size: 18px;
    transition: all 0.5s;
}
        
.prayag-btn:hover svg path {
    fill: #fff;
}

.prayag-btn:hover {
    background: linear-gradient(135deg, #0056b3, #004085);
    color: white!important;
    transform: translateY(-2px);
}
        
.logo-slider {
    margin-top: 40px;
    display: flex;
    overflow: hidden;
}

.logo-slider-container {
    overflow: hidden;
    position: relative;
    padding: 30px 0 0 0;
    background: #fff;
    border-radius: 10px;
}

.logo-item {
    flex: 0 0 25%;
    padding: 0 10px;
}
        
@media (max-width: 768px) {
    .logo-item {
        flex: 0 0 50%;
    }
}
        
@media (max-width: 576px) {
    .logo-item {
        flex: 0 0 100%;
    }
}

.logo-item p {
    text-align: center;
    margin-top: 12px;
    font-size: 22px;
    line-height: 32px;
    font-weight: 400;
}

.logo-box {
    background: white;
    border-radius: 15px;
    padding: 20px;
    margin: 0;
    border: 1px solid #eee;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100px;
}
        
.logo-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}
     
.logo-box img {
    max-width: 100%;
    max-height: 120px;
    object-fit: contain;
    filter: grayscale(0.3);
    transition: filter 0.3s ease;
}
        
.logo-box:hover img {
    filter: grayscale(0);
}
        
@media (max-width: 768px) {
    .ipl-head h2 {
        font-size: 2rem;
        text-align: center;
        margin-bottom: 20px;
    }
    
    .ipl-rt-cont {
        text-align: center;
    }
    
    .official-ipl {
        padding: 40px 0;
    }
    
    .slick-prev, .slick-next {
        display: none !important;
    }
}
</style>

<style>
.navik-header {
    position: absolute;
}

.path-frontpage .navik-header {
    position: absolute;
    background: transparent;
}

.black_logo img {
    filter: brightness(10000);
}

.navik-header:hover .black_logo img {
    filter: brightness(0) !important;
}

.navik-header nav.navik-menu.menu-caret.submenu-top-border ul li a {
    color: #fff;
}

.navik-header.sticky .black_logo img {
    filter: brightness(0) !important;
}

.navik-header.sticky nav.navik-menu.menu-caret.submenu-top-border ul li a {
    color: #000;
}

.navik-header:not(.sticky) .login_icon svg path {
    fill: #fff;
}

.navik-header.header-transparent.header-shadow.navik-mega-menu.mega-menu-fullwidth.viewport-lg.header-transparent-on {
    background: transparent;
}

.navik-header {
    position: absolute !important;
}

.video-showcase {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: #000;
}

.video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
}

.video-slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s ease-in-out;
}

.video-slide.active {
    opacity: 1;
}

/*
   <picture> wrapper — fills the slide exactly like the old <img>
   Both <source> and <img> inside it are position:absolute full-bleed.
*/
.video-slide picture {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2; /* Above video — ensures <img> inside is LCP element */
    display: block;
}

.video-slide picture img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top; /* show face/subject on mobile crop */
    transition: opacity 0.6s ease;
}

/* Video sits below picture by default */
.video-slide video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.6s ease;
}

/* Once video is ready — rise above picture, picture fades out */
.video-slide video.video-ready {
    z-index: 3;
    opacity: 1;
}

.video-slide video.video-ready ~ picture,
.video-slide picture.img-hidden {
    opacity: 0;
    pointer-events: none;
}

/* Controls */
.video-controls {
    position: absolute;
    bottom: 30px;
    right: 30px;
    display: flex;
    gap: 15px;
    z-index: 10;
}

.control-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #fff;
    outline: none;
}

.control-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
}

.control-btn svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
}

/* Progress Indicator */
.progress-indicator {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
}

.progress-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
}

.progress-dot.active {
    width: 30px;
    border-radius: 4px;
    background: #fff;
}

/* Mobile */
@media (max-width: 768px) {
    .video-showcase {
        height: auto;
        aspect-ratio: 4 / 3;
    }

    .video-controls {
        bottom: 20px;
        right: 20px;
    }
    
    .control-btn {
        width: 40px;
        height: 40px;
    }

    .navik-header.header-transparent.header-shadow.navik-mega-menu.mega-menu-fullwidth.viewport-sm {
        position: static !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    .video-slide {
        transition: opacity 0.3s ease-in-out;
    }
    .video-slide picture,
    .video-slide video {
        transition: opacity 0.2s ease;
    }
}
</style>

