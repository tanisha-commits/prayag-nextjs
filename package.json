{
  "name": "prayag-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Prayag Polymers Limited website (prayagindia.com) built with Next.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanisha-commits/prayag-nextjs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/images/image-dimensions.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "deploy:package": "bash scripts/deploy/package.sh"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
