{
  "name": "ai-website-clone-template",
  "version": "0.6.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/images/image-dimensions.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/admin/create-admin.mts",
    "admin:bundle": "tsx scripts/admin/bundle-admin.mts",
    "deploy:package": "bash scripts/deploy/package.sh",
    "content:export": "tsx --env-file-if-exists=.env.local scripts/content/export.mts",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/content/import.mts",
    "mcp:content": "tsx --env-file-if-exists=.env.local scripts/mcp/prayag-content.mts",
    "catalog:extract-live": "python3 -I scripts/catalog/extract-live.py",
    "catalog:import": "tsx --env-file-if-exists=.env.local scripts/catalog/import.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.6.0",
    "marked": "^18.1.3",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
