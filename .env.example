# Prayag enquiry forms (/contact-us, /dealership-enquiry) -> server-side lead forwarding.
# Server-only values: never prefix with NEXT_PUBLIC_. Copy to .env.local (or set in the host's
# environment settings) and fill in. With forwarding disabled or no destination configured, the
# forms answer HTTP 503 "Online enquiries are not connected yet ..." and nothing is sent.

# Master switch: forwarding runs only when this is exactly "enabled".
PRAYAG_ENQUIRY_FORWARDING=

# ezeone.tech website-enquiry API (JSON body carries the auth key).
PRAYAG_EZEONE_API_AUTH_KEY=
# Optional override; defaults to https://ezeone.tech/api/enquiry/website-enquiry
PRAYAG_EZEONE_ENQUIRY_URL=

# AbacusDesk TrackerHub leads API (x-website-id / x-api-key headers).
PRAYAG_TRACKERHUB_WEBSITE_ID=
PRAYAG_TRACKERHUB_API_KEY=
# Optional override; defaults to https://api.abacusdesk.co.in/api/v1/leads
PRAYAG_TRACKERHUB_LEADS_URL=

# Optional per-request timeout in ms (default 10000, max 30000).
PRAYAG_ENQUIRY_TIMEOUT_MS=

# ---------- Product catalog database + admin (see docs/catalog/README.md) ----------
# SQLite file holding the catalog, admin users and audit history (default: data/prayag.db).
PRAYAG_DB_PATH=
# Better Auth: 32+ random bytes, e.g. `openssl rand -base64 32`. Required; never commit it.
BETTER_AUTH_SECRET=
# Public origin of the site, e.g. http://localhost:3000 locally.
BETTER_AUTH_URL=
# Optional AI assistant for the admin (suggestions only). Leave empty to keep AI features off.
# No provider adapter is wired yet (src/lib/ai/provider.ts); the key would stay server-side.
PRAYAG_AI_PROVIDER=
PRAYAG_AI_API_KEY=
PRAYAG_AI_MODEL=
